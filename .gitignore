# Build artifacts
/build*/
/_skbuild/
/bin/
/obj/

# External libraries (git submodules 或手動下載)
lib/

# IDE / editor
.vscode/

# Agent rules
.agent/
AGENT.md

# Notes (optional, 看你要不要 track)
survey/
Classnote/
benchmarks/literature/
benchmarks/output/
# Python
__pycache__/
*.egg-info/
*.so
*.pyd

# Exclude profiling generated data
benchmarks/profiling/**/*.data
benchmarks/profiling/**/*.out
benchmarks/profiling/**/*.cprof
# 想排除除了 md 和 python 腳本外的所有檔案，可自行撰寫規則
benchmarks/profiling/**/*.txt
benchmarks/profiling/**/*.json
benchmarks/profiling/**/*.err

